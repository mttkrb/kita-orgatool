# Zugangsdaten für den Umzug. Kopieren nach umzug.env und ausfüllen.
# umzug.env enthält Datenbank-Passwörter: nie committen, nach dem Umzug löschen.
#
# Werte stehen im Supabase-Dashboard des jeweiligen Projekts oben unter "Connect",
# Reiter "Direct", Abschnitt "Session pooler" (nicht "Transaction pooler").
# Das Passwort ist das Datenbank-Passwort des Projekts (Project Settings > Database),
# nicht das Passwort des Supabase-Kontos und nicht das Orga-Passwort.
# Anführungszeichen um den Wert sind erlaubt, aber nicht nötig.

# Altes Projekt – wird nur gelesen
ALT_HOST=
ALT_PORT=5432
ALT_USER=
ALT_PASSWORT=

# Neues Projekt – wird beschrieben
NEU_HOST=
NEU_PORT=5432
NEU_USER=
NEU_PASSWORT=

# Beispiel:
# NEU_HOST=aws-0-eu-central-1.pooler.supabase.com
# NEU_USER=postgres.abcdefghijklmnopqrst

# Optional, aber empfohlen: prüft nach dem Einspielen über die Schnittstelle, ob die
# Rechte stimmen, vor allem dass signups.token gesperrt ist. Werte aus dem neuen
# Projekt: Project Settings > API (bzw. "API Keys" > "Legacy API Keys", anon public).
NEU_URL=
NEU_ANON_KEY=

# Optional: anderes Docker-Abbild, falls ohne lokale PostgreSQL-Werkzeuge gearbeitet wird.
# Standard ist postgres:17-alpine oder neuer, passend zur Serverversion.
PG_DOCKER_IMAGE=
