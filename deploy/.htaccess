# Für den Zielordner der Seiten auf dem Webspace (meist /orga/).
# Vor dem Hochladen PROJEKT-REF durch die eigene Project URL aus config.js ersetzen,
# sonst blockiert der Browser jede Abfrage an die Datenbank.
#
# Die Seiten laden nur eigene Dateien (Grundregel 2). Skripte und Stile stehen in den
# Seiten selbst, daher 'unsafe-inline'. Fotos zu Aufgaben sind data:-Bilder.

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://PROJEKT-REF.supabase.co; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  # Persönliche Links tragen das Token in der Adresse; beim Klick auf einen Zahlweg-Link
  # soll es nicht als Referrer mitgehen.
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Nach einem Update sollen Browser die neuen Dateien holen, nicht die alten aus dem Zwischenspeicher.
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
